
#include <stdio.h>

struct Student
{
    int rollno;
    char name[50];
    float marks;
};

int main()
{
    struct Student s[100];
    FILE *fp;
    int n, i, highest = 0;
    float sum = 0, average;

    printf("Enter number of students: ");
    scanf("%d", &n);

    if(n < 1 || n > 100)
    {
        printf("Invalid number of students!");
        return 0;
    }

    fp = fopen("students.txt", "w");

    if(fp == NULL)
    {
        printf("File cannot be opened!");
        return 0;
    }

    for(i = 0; i < n; i++)
    {
        scanf("%d %49s %f", &s[i].rollno,
              s[i].name, &s[i].marks);

        fprintf(fp, "%d %s %.2f\n",
                s[i].rollno, s[i].name, s[i].marks);

        sum += s[i].marks;

        if(i == 0 || s[i].marks > s[highest].marks)
            highest = i;
    }

    fclose(fp);

    average = sum / n;

    printf("\nHighest Mark: %.0f (%s)",
           s[highest].marks, s[highest].name);

    printf("\nClass Average: %.2f", average);

    printf("\n%d records stored successfully.", n);

    return 0;
}
