
#include <stdio.h>

int main()
{
    int a[50], n, i;
    int x = 0, y = 1, temp;
    int sum = 0, largest;

    printf("Enter number of terms (1-50): ");
    scanf("%d", &n);

    if(n < 1 || n > 50)
    {
        printf("Invalid input! Please enter terms between 1 and 50.");
        return 0;
    }

    for(i = 0; i < n; i++)
    {
        a[i] = x;
        temp = x + y;
        x = y;
        y = temp;
    }

    largest = a[0];

    printf("Fibonacci Series: ");

    for(i = 0; i < n; i++)
    {
        printf("%d ", a[i]);
        sum += a[i];

        if(a[i] > largest)
            largest = a[i];
    }

    printf("\nSum of series: %d", sum);
    printf("\nLargest term: %d", largest);

    return 0;
}
