
#include <stdio.h>
#include <time.h>

int calls = 0;

long long fibonacci(int n)
{
    calls++;

    if(n == 0)
        return 0;
    if(n == 1)
        return 1;

    return fibonacci(n-1) + fibonacci(n-2);
}

int main()
{
    int n, i;
    long long a = 0, b = 1, c;
    clock_t start, end;
    double iterativeTime, recursiveTime;

    printf("Enter N: ");
    scanf("%d", &n);

    if(n < 1 || n > 50)
    {
        printf("Invalid input! Enter N between 1 and 50.");
        return 0;
    }

    start = clock();

    printf("Iterative: ");

    for(i = 0; i < n; i++)
    {
        printf("%lld ", a);
        c = a + b;
        a = b;
        b = c;
    }

    end = clock();
    iterativeTime = ((double)(end-start) / CLOCKS_PER_SEC) * 1000;

    start = clock();

    printf("\nRecursive: ");

    calls = 0;

    for(i = 0; i < n; i++)
    {
        printf("%lld ", fibonacci(i));
    }

    end = clock();
    recursiveTime = ((double)(end-start) / CLOCKS_PER_SEC) * 1000;

    printf("\nRecursive Calls: %d", calls);
    printf("\nIterative Time: %.3f ms", iterativeTime);
    printf("\nRecursive Time: %.3f ms", recursiveTime);

    return 0;
}
