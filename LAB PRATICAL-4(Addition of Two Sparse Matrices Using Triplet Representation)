
#include <stdio.h>

#define MAX 100

struct Term
{
    int row, col, value;
};

int main()
{
    struct Term A[MAX], B[MAX], C[MAX];
    int r1, c1, r2, c2;
    int n1, n2, n3 = 0;
    int i, j, k;

    printf("Enter rows, columns and non-zero terms of Matrix 1: ");
    scanf("%d %d %d", &r1, &c1, &n1);

    printf("Enter Matrix 1 terms (row col value):\n");
    for(i = 0; i < n1; i++)
        scanf("%d %d %d", &A[i].row, &A[i].col, &A[i].value);

    printf("Enter rows, columns and non-zero terms of Matrix 2: ");
    scanf("%d %d %d", &r2, &c2, &n2);

    printf("Enter Matrix 2 terms (row col value):\n");
    for(i = 0; i < n2; i++)
        scanf("%d %d %d", &B[i].row, &B[i].col, &B[i].value);

    if(r1 != r2 || c1 != c2)
    {
        printf("Matrix addition not possible!");
        return 0;
    }

    i = 0;
    j = 0;

    while(i < n1 && j < n2)
    {
        if(A[i].row < B[j].row ||
          (A[i].row == B[j].row && A[i].col < B[j].col))
        {
            C[n3++] = A[i++];
        }
        else if(B[j].row < A[i].row ||
          (B[j].row == A[i].row && B[j].col < A[i].col))
        {
            C[n3++] = B[j++];
        }
        else
        {
            int sum = A[i].value + B[j].value;

            if(sum != 0)
            {
                C[n3] = A[i];
                C[n3].value = sum;
                n3++;
            }

            i++;
            j++;
        }
    }

    while(i < n1)
        C[n3++] = A[i++];

    while(j < n2)
        C[n3++] = B[j++];

    printf("\nResult in Triplet Form:\n");
    printf("Row Col Value\n");

    for(i = 0; i < n3; i++)
        printf("%d   %d   %d\n",
               C[i].row, C[i].col, C[i].value);

    printf("\nSum Dense Matrix:\n");

    k = 0;

    for(i = 0; i < r1; i++)
    {
        for(j = 0; j < c1; j++)
        {
            if(k < n3 && C[k].row == i && C[k].col == j)
                printf("%d ", C[k++].value);
            else
                printf("0 ");
        }
        printf("\n");
    }

    return 0;
}
