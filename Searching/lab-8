#include <stdio.h>

int main()
{
    int arr[10], target;
    int low = 0, high = 9, mid;
    int comparisons = 0, found = 0;

    printf("Enter 10 sorted integers:\n");

    for (int i = 0; i < 10; i++)
    {
        scanf("%d", &arr[i]);
    }

    printf("Enter element to search: ");
    scanf("%d", &target);

    while (low <= high)
    {
        mid = (low + high) / 2;
        comparisons++;

        if (arr[mid] == target)
        {
            found = 1;
            break;
        }
        else if (arr[mid] < target)
        {
            low = mid + 1;
        }
        else
        {
            high = mid - 1;
        }
    }

    if (found)
    {
        printf("Element %d found at position %d\n",
               target, mid + 1);
    }
    else
    {
        printf("Element %d not found\n", target);
    }

    printf("Comparisons made: %d\n", comparisons);

    return 0;
}
