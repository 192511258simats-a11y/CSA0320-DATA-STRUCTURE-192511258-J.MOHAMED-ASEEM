#include <stdio.h>
#include <stdlib.h>

struct Node
{
    int data;
    struct Node *next;
};

int main()
{
    struct Node *head = NULL, *tail = NULL, *newNode, *temp;
    int arr[] = {10, 20, 30, 40};

    for (int i = 0; i < 4; i++)
    {
        newNode = malloc(sizeof(struct Node));
        newNode->data = arr[i];
        newNode->next = NULL;

        if (head == NULL)
        {
            head = tail = newNode;
            tail->next = head;
        }
        else
        {
            tail->next = newNode;
            tail = newNode;
            tail->next = head;
        }
    }

    printf("Circular Linked List: ");

    temp = head;

    if (head != NULL)
    {
        do
        {
            printf("%d -> ", temp->data);
            temp = temp->next;
        }
        while (temp != head);
    }

    printf("Back to Head\n");

    return 0;
}
