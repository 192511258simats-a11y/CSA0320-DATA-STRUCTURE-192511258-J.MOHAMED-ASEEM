#include <stdio.h>
#include <string.h>
#include <ctype.h>

int areAnagrams(char str1[], char str2[])
{
    int count[256] = {0};
    int i;

    if (strlen(str1) != strlen(str2))
        return 0;

    for (i = 0; str1[i] != '\0'; i++)
    {
        count[tolower(str1[i])]++;
        count[tolower(str2[i])]--;
    }

    for (i = 0; i < 256; i++)
    {
        if (count[i] != 0)
            return 0;
    }

    return 1;
}

int main()
{
    char str[50][100], target[100];
    int n, i, found = 0;

    printf("Enter n: ");
    scanf("%d", &n);

    if (n <= 0 || n > 50)
    {
        printf("Invalid size!\n");
        return 0;
    }

    printf("Enter %d strings:\n", n);

    for (i = 0; i < n; i++)
    {
        scanf("%s", str[i]);
    }

    printf("Target: ");
    scanf("%s", target);

    printf("Anagrams found at positions: ");

    // Linear Search
    for (i = 0; i < n; i++)
    {
        if (areAnagrams(str[i], target))
        {
            printf("%d ", i + 1);
            found++;
        }
    }

    if (found == 0)
    {
        printf("Not found");
    }

    printf("\nMatches: ");

    // Display matching strings
    for (i = 0; i < n; i++)
    {
        if (areAnagrams(str[i], target))
        {
            printf("%s ", str[i]);
        }
    }

    if (found == 0)
    {
        printf("None");
    }

    printf("\n");

    return 0;
}
